{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kinbo",
  "compatibility_date": "2026-04-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference service binding commented out for initial deployment
  // Uncomment and update service name after first deployment if needed
  // "services": [
  //   {
  //     "binding": "WORKER_SELF_REFERENCE",
  //     "service": "getkinbo"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "getkinbo-opennext-cache"
  //   }
  // ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}